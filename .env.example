# Copy to .env.local and fill in. Never commit .env.local.

# PayPal sandbox REST app (developer.paypal.com → Apps & Credentials → Sandbox → your app)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" (default) or "live"
PAYPAL_ENV=sandbox
# Webhook ID from the sandbox app's Webhooks section (only needed on a public deployment)
PAYPAL_WEBHOOK_ID=
# Optional: a PayPal sandbox personal (buyer) account shown on /shop so visitors and judges
# can approve the sandbox checkout. Only a real sandbox address (…@personal.example.com) is shown.
# Sandbox accounts hold test money only. Never use a real PayPal login. The shop also offers an
# instant demo that needs no login (subscription IDs starting I-DEMO, answered by the in-app simulator).
# DEMO_BUYER_EMAIL=
# DEMO_BUYER_PASSWORD=

# Claude (Anthropic API) — powers the retention agent and the demo consumer agent
ANTHROPIC_API_KEY=
# Optional override; default claude-haiku-5-5 (lowest cost). For more capable replies, e.g.:
# KEEPALIVE_MODEL=claude-sonnet-5-5

# Public base URL of this app (used for PayPal return/cancel URLs)
APP_URL=http://localhost:3000

# Required on Vercel: connect a private Blob store (local development uses data/store.json).
BLOB_READ_WRITE_TOKEN=
# Vercel Cron sends this as a Bearer token; generate a long random value for deployment.
CRON_SECRET=

# Optional (hosted deploys): pin the PayPal catalog created by "Set up PayPal plans"
# so a restart on an ephemeral disk doesn't create new plans. Copy the IDs from /merchant → PayPal activity.
# PAYPAL_PRODUCT_ID=
# PAYPAL_PLAN_LITE=
# PAYPAL_PLAN_STANDARD=
# PAYPAL_PLAN_PREMIUM=

# Optional: protects /merchant and admin APIs on a public deployment
# ADMIN_TOKEN=
